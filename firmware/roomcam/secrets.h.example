// Wi-Fi credentials for the roomcam firmware.
//
// Setup:
//   1. Copy this file to secrets.h (secrets.h is gitignored and never committed).
//   2. Fill in your network's SSID and password.
//   3. Change SECRETS_CONFIGURED to 1.
//
// The build intentionally fails until step 3 is done, so placeholder
// credentials can never be flashed by accident.

#pragma once

#define SECRETS_CONFIGURED 0

#if !SECRETS_CONFIGURED
#error "Edit secrets.h: set WIFI_SSID / WIFI_PASSWORD, then set SECRETS_CONFIGURED to 1."
#endif

#define WIFI_SSID "YourNetwork"
#define WIFI_PASSWORD "YourPassword"

// mDNS hostname: the camera will also be reachable at http://roomcam.local/
#define CAMERA_HOSTNAME "roomcam"
